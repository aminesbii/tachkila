# Rooms are stored in MongoDB. Copy this file to .env.local and set your Atlas URI.
# A free tier cluster is plenty for this game.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tachkila

# Set to "memory" to play with no database at all: rooms live in the app process
# and are cleared when the server restarts. Set to "mongodb" to force Atlas.
# TACHKILA_STORE=memory
